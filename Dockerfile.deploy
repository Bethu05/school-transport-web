FROM node:22-alpine AS build
WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci
COPY . .

ARG VITE_API_URL
ARG VITE_REALTIME_URL
ARG VITE_MAPBOX_ACCESS_TOKEN
ARG VITE_MAPBOX_STYLE=mapbox://styles/mapbox/streets-v12
ARG ALLOW_LOCAL_URLS=false
RUN test -n "$VITE_API_URL" \
    && test -n "$VITE_REALTIME_URL" \
    && test -n "$VITE_MAPBOX_ACCESS_TOKEN" \
    && npm run build \
    && { [ "$ALLOW_LOCAL_URLS" = "true" ] || ! grep -R -l -E 'http://(localhost|127\.0\.0\.1):300[02]' dist; } \
    && ! grep -R -l -E 'VITE_DEV_PASSWORD|assistant\.platform\.admin@example\.test' dist

FROM nginxinc/nginx-unprivileged:stable-alpine
COPY --from=build /app/dist/ /usr/share/nginx/html/
COPY deploy/nginx.demo.conf /etc/nginx/conf.d/default.conf
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s --start-period=5s \
  CMD wget -q -O /dev/null http://127.0.0.1:8080/ || exit 1
