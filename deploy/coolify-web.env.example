# These values are compiled into the Vite bundle at BUILD TIME.
#
# Changing either value requires a new Coolify deployment/build.

VITE_API_URL=https://YOUR-API-DOMAIN
VITE_REALTIME_URL=https://YOUR-REALTIME-DOMAIN

# Mapbox GL JS — public browser token only.
# Use a dedicated token per environment and apply URL restrictions.
VITE_MAPBOX_ACCESS_TOKEN=pk.YOUR_MAPBOX_PUBLIC_TOKEN
VITE_MAPBOX_STYLE=mapbox://styles/mapbox/streets-v12
